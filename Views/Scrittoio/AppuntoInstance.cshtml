@using AmbienteDiProva.Models;
@model Appunto;

@{
    ViewData["Title"] = "";
}

<form class="mt-3" asp-controller="Scrittoio" asp-action="AppInstPost" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" class="mod-id"/>
    <div class="mb-3">
        <input asp-for="Titolo" class="form-control title"/>
    </div>
    <div class="mb-3 w-100">
        <textarea asp-for="Testo" class="tex w-100" style="min-height: 30vh"></textarea>
    </div>
    <div>
        <input type="button" value="Elimina" class="btn btn-primary del"/>
    </div>
</form>

@section Scripts{
    @{
        <script src="~/js/AppuntoInstance.js"></script>
    }
}