@using AmbienteDiProva.Models;
@model Appunto;

@{
    ViewData["Title"] = "Scrittura";
}

<form asp-controller="Scrittoio" asp-action="ScritturaPost" method="post" class="container-fluid scForm w-75">
    <div asp-validation-summary="ModelOnly" class="text-error"></div>

    <div class="mb-3">
        <input type="text" asp-for="Titolo"class="form-control" id="tit" placeholder="Titolo..."/>
        <span asp-validation-for="Titolo"></span>
    </div>

    <div class="mb-3">
        <textarea type="text" asp-for="Testo" class="form-control" id="tex" placeholder="Area di testo..." style="min-height: 30vh"></textarea>
        <span asp-validation-for="Testo"></span>
    </div>

    <div class="mb-3">
        <input type="submit" value="Salva" class="btn btn-primary"/>
    </div>
</form>


@section Scripts{
    @{
        <script src="~/js/Scrittura.js"></script>
    }
}