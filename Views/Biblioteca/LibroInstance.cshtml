@using AmbienteDiProva.Models;
@model Libro;

@{
    ViewData["Title"] = "LibroInstance";
}

<style>
    .but-sav{
        background: rgba(173, 216, 230, 0.7);
        font-size: 30px;
        font-weight: 400;
        transition: 0.5s ease-in-out;
    }

    .but-del {
        background: rgba(255, 127, 127, 0.7);
        font-size: 30px;
        font-weight: 400;
        transition: 0.5s ease-in-out;
    }

    .but-del:hover {
        background: rgba(255, 127, 127, 1);
        font-weight: 450;
        scale: 1.02;
        transition: 0.8s ease-in-out;
    }

    .but-sav:hover{
        background: rgba(173, 216, 230, 1);
        font-weight: 450;
        scale: 1.02;
        transition: 0.8s ease-in-out;
    }

    .lib-res{
        line-height: 2rem;
    }

</style>

<div class="container-fluid text-center d-flex flex-column align-items-center justify-content-center gap-3 mt-5">

    @if(Model.GutenbergId == 0)
    {
        <p class="d-none lib-id-main">@Model.Id</p>
    }
    else
    {
        <p class="d-none lib-id-main">@Model.GutenbergId</p>
    }


    <h1 class="lib-nome mb-4">@Model.Nome.Replace("$b ", "")</h1>
    <img class="lib-img rounded-2 border-1 border-end border-bottom border-dark shadow-lg"  src=@Model.Img />
    <div class="d-flex flex-row align-item-center justify-content-center gap-3">
        <a class="link-online" href=@Model.OnlineLink>Leggi il testo su Gutenberg.org</a>
        <a class="link-download" href=@Model.DownloadLink>Scarica il testo da Gutenberg.org</a>
    </div>
    <h3 class="lib-aut">@Model.Autore</h3>
    <div class="lib-cat gap-1"> 
        <h4>Categorie:</h4>
        <p class="lib-categs">@Model.Category.Replace("[", "").Replace("]", "").Replace("Category: ", "")</p>
    </div>
    <div class="gap-1 resume text-center w-50">
        <h4>Riassunto:</h4>
        <p class="lib-res">@Model.Resume</p>
    </div>

    

    <div class="but-sub d-flex flex-column align-items-center justify-content-center gap-2">
        <button class="border-0 rounded-2 px-3 py-2 but-sav">Salva</button>
        <button class="invisible border-0 rounded-2 px-3 py-2 but-del" disabled>Elimina</button>
    </div>

</div>

@section Scripts{
    @{
        <script src="~/js/LibroInstance.js"></script>
    } 
}

